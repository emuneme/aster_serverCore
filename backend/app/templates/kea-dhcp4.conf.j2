// Kea DHCPv4 Configuration - Generated by SGLinux
{
    "Dhcp4": {
        "interfaces-config": {
            "interfaces": [ "{{ interface | default('*') }}" ]
        },
        "lease-database": {
            "type": "memfile",
            "persist": true,
            "name": "/var/lib/kea/kea-leases4.csv",
            "lfc-interval": 3600
        },
        "valid-lifetime": {{ valid_lifetime | default(43200) }},
        "renew-timer": {{ renew_timer | default(21600) }},
        "rebind-timer": {{ rebind_timer | default(37800) }},
        "subnet4": [
{% for sub in subnets %}
            {
                "id": {{ loop.index }},
                "subnet": "{{ sub.subnet }}",
                "pools": [
                    { "pool": "{{ sub.pool_start }} - {{ sub.pool_end }}" }
                ],
                "option-data": [
{% if sub.gateway %}
                    {
                        "name": "routers",
                        "data": "{{ sub.gateway }}"
                    }{% if sub.dns_servers or sub.domain_name %},{% endif %}
{% endif %}
{% if sub.dns_servers %}
                    {
                        "name": "domain-name-servers",
                        "data": "{{ sub.dns_servers | join(', ') }}"
                    }{% if sub.domain_name %},{% endif %}
{% endif %}
{% if sub.domain_name %}
                    {
                        "name": "domain-name",
                        "data": "{{ sub.domain_name }}"
                    }
{% endif %}
                ]
{% if sub.reservations %}
                ,
                "reservations": [
{% for res in sub.reservations %}
                    {
                        "hw-address": "{{ res.mac_address }}",
                        "ip-address": "{{ res.ip_address }}"{% if res.hostname %},
                        "hostname": "{{ res.hostname }}"{% endif %}
                    }{% if not loop.last %},{% endif %}
{% endfor %}
                ]
{% endif %}
            }{% if not loop.last %},{% endif %}
{% endfor %}
        ]
    }
}
