# Generated by SGLinux Management System
# Netplan 01-netcfg.yaml
network:
  version: 2
  renderer: {{ renderer | default('networkd') }}
  ethernets:
{% for iface_name, iface in ethernets.items() %}
    {{ iface_name }}:
      dhcp4: {{ 'true' if iface.dhcp4 else 'false' }}
{% if not iface.dhcp4 and iface.addresses %}
      addresses:
{% for addr in iface.addresses %}
        - {{ addr }}
{% endfor %}
{% endif %}
{% if not iface.dhcp4 and iface.gateway4 %}
      routes:
        - to: default
          via: {{ iface.gateway4 }}
{% endif %}
{% if iface.nameservers and iface.nameservers.addresses %}
      nameservers:
        addresses:
{% for ns in iface.nameservers.addresses %}
          - {{ ns }}
{% endfor %}
{% if iface.nameservers.search %}
        search:
{% for s in iface.nameservers.search %}
          - {{ s }}
{% endfor %}
{% endif %}
{% endif %}
{% if iface.mtu %}
      mtu: {{ iface.mtu }}
{% endif %}
{% endfor %}
