// BIND9 named.conf.options - Generated by SGLinux
options {
    directory "/var/cache/bind";

    // Forwarders for external DNS queries
    forwarders {
{% for forwarder in forwarders %}
        {{ forwarder }};
{% endfor %}
    };

    dnssec-validation auto;

    listen-on-v6 { any; };
    listen-on { any; };

    allow-query { any; };
    recursion yes;
};
