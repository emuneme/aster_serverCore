# Dnsmasq Configuration - Generated by SGLinux
{% if interface %}
interface={{ interface }}
{% endif %}
bind-interfaces

{% if domain %}
domain={{ domain }}
expand-hosts
{% endif %}

{% for sub in subnets %}
dhcp-range={{ sub.pool_start }},{{ sub.pool_end }},{{ sub.subnet_mask | default('255.255.255.0') }},{{ sub.lease_time | default('12h') }}
{% if sub.gateway %}
dhcp-option=option:router,{{ sub.gateway }}
{% endif %}
{% if sub.dns_servers %}
dhcp-option=option:dns-server,{{ sub.dns_servers | join(',') }}
{% endif %}
{% if sub.domain_name %}
dhcp-option=option:domain-name,{{ sub.domain_name }}
{% endif %}
{% for res in sub.reservations %}
dhcp-host={{ res.mac_address }},{{ res.ip_address }}{% if res.hostname %},{{ res.hostname }}{% endif %}
{% endfor %}
{% endfor %}

dhcp-authoritative
