# Global parameters - Generated by SGLinux for Samba 4 AD DC
[global]
    netbios name = {{ domain }}
    realm = {{ realm }}
    workgroup = {{ domain }}
    server role = active directory domain controller
    idmap_ldb:use rfc2307 = yes

    # DNS Backend Configuration
{% if dns_backend == 'BIND9_DLZ' %}
    server services = -dns
{% else %}
    dns forwarder = {{ dns_forwarder | default('8.8.8.8') }}
{% endif %}

    # Security & TLS
    tls enabled = yes
    tls keyfile = tls/key.pem
    tls certfile = tls/cert.pem
    tls cafile = tls/ca.pem

    # Kerberos and Authentication
    kerberos method = secrets and keytab
    winbind enum users = yes
    winbind enum groups = yes
    winbind use default domain = yes

    # SMB protocol version limits
    server min protocol = SMB2_02

[sysvol]
    path = /var/lib/samba/sysvol
    read only = No

[netlogon]
    path = /var/lib/samba/sysvol/{{ realm.lower() }}/scripts
    read only = No
